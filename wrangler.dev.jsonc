{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mai-coach-dev",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_vinext/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mai-coach-dev-db",
      "database_id": "d5460c93-f47d-4c69-ad29-787546aec4ca",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEO_STORAGE",
      "bucket_name": "mai-coach-video-storage-dev"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "media": {
    "binding": "MEDIA",
    "remote": true
  },
  "workflows": [
    {
      "name": "mai-coach-video-recap-dev",
      "binding": "VIDEO_LESSON_RECAP_WORKFLOW",
      "class_name": "VideoLessonRecapWorkflow"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://mai-coach-dev.b9-golf-practice-dashboard.workers.dev",
    "DEV_AUTH_ENABLED": "false",
    "COACH_EMAILS": "",
    "ADMIN_EMAILS": "",
    "OPENAI_MODEL": "gpt-5.6-terra",
    "OPENAI_TRANSCRIPTION_MODEL": "gpt-4o-transcribe",
    "RESEND_FROM": "notifications@n3xconsulting.com",
    "VIDEO_EMAIL_FROM": "notifications@n3xconsulting.com"
  }
}
