{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "b9-golf-practice-dashboard",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_vinext/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b9-golf-practice-dashboard-db",
      "database_id": "aae258e6-d671-4307-b558-9594640337f1",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEO_STORAGE",
      "bucket_name": "b9-golf-video-storage"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "APP_BASE_URL": "https://b9-golf-practice-dashboard.b9-golf-practice-dashboard.workers.dev",
    "DEV_AUTH_ENABLED": "false",
    "COACH_EMAILS": "",
    "ADMIN_EMAILS": "",
    "OPENAI_MODEL": "gpt-5.6-terra",
    "RESEND_FROM": "notifications@n3xconsulting.com",
    "VIDEO_EMAIL_FROM": "notifications@n3xconsulting.com"
  }
}
