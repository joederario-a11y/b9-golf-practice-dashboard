{
  "name": "golfiq-performance-analytics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:worker": "rm -rf dist && vinext build",
    "preview:worker": "npm run build:worker && cd dist/server && wrangler dev --config wrangler.json --port 8787",
    "deploy:dry-run": "npm run build:worker && cd dist/server && wrangler deploy --config wrangler.json --dry-run --outdir ../../.wrangler/dry-run",
    "deploy": "npm run build:worker && cd dist/server && wrangler deploy --config wrangler.json",
    "start": "vinext start",
    "lint": "node scripts/lint-source.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "exifr": "^7.1.3",
    "next": "16.2.6",
    "openai": "^6.47.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
